<resources>
    <!-- Tema general: Material Components claro y sin barra superior -->
    <style name="Theme.Floreria" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rosa_fuerte</item>
        <item name="colorPrimaryVariant">@color/rosa_oscuro</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/verde_oscuro</item>
        <item name="colorSecondaryVariant">@color/verde_oscuro</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/rosa_fondo</item>
        <item name="android:statusBarColor">@color/rosa_fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/texto_principal</item>

        <!-- Estilos que se aplican automáticamente a todos los botones y campos -->
        <item name="materialButtonStyle">@style/Boton.Floreria</item>
        <item name="textInputStyle">@style/Campo.Floreria</item>
    </style>

    <!-- Botón moderno con esquinas redondeadas -->
    <style name="Boton.Floreria" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/rosa_fuerte</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <!-- Botón secundario con borde rosa -->
    <style name="Boton.Floreria.Borde" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/rosa_fuerte</item>
        <item name="android:textColor">@color/rosa_fuerte</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <!-- Campo de texto con borde redondeado -->
    <style name="Campo.Floreria" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/rosa_fuerte</item>
        <item name="hintTextColor">@color/rosa_fuerte</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Tarjeta blanca con esquinas redondeadas -->
    <style name="Tarjeta.Floreria" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>