<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 1: Inicio de sesión -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rosa_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logotipo -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="@string/descripcion_logo"
            android:src="@drawable/ic_logo_flor" />

        <!-- Nombre y eslogan de la florería -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nombre_floreria"
            android:textColor="@color/rosa_fuerte"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/eslogan"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <!-- Línea verde decorativa -->
        <View
            android:layout_width="70dp"
            android:layout_height="3dp"
            android:layout_marginBottom="20dp"
            android:background="@color/verde_suave" />

        <!-- Tarjeta con el formulario -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta.Floreria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="@string/login_titulo"
                    android:textColor="@color/rosa_oscuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Campo de correo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_correo"
                    app:startIconDrawable="@drawable/ic_correo"
                    app:startIconTint="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreoLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo de contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilClaveLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/login_clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:startIconTint="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClaveLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón principal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/login_boton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Enlace a la pantalla de registro -->
        <TextView
            android:id="@+id/tvIrRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/login_registro"
            android:textColor="@color/rosa_oscuro"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>