<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de Bienvenida / Login inspirada en el prototipo -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logotipo circular -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_logo_circle"
            android:padding="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/descripcion_logo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_logo_flor" />
        </FrameLayout>

        <!-- Nombre de la florería -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.05"
            android:text="@string/nombre_floreria"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.2"
            android:text="@string/splash_tagline"
            android:textColor="@color/rosa_pastel"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/splash_titulo"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Subtítulo / Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/splash_subtitulo"
            android:textColor="#E0C2CE"
            android:textSize="15sp" />

        <!-- Botón Comenzar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComenzar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="40dp"
            android:minHeight="52dp"
            android:text="@string/splash_comenzar"
            android:textColor="@color/rosa_oscuro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="26dp" />

        <!-- Enlace Ya tengo una cuenta -->
        <TextView
            android:id="@+id/tvYaTengoCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/splash_ya_tengo_cuenta"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Tarjeta de Login (se muestra al hacer clic en Comenzar o Ya tengo una cuenta) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginContainer"
            style="@style/Tarjeta.Floreria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/login_titulo"
                    android:textColor="@color/rosa_oscuro"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Campo de correo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_correo"
                    app:startIconDrawable="@drawable/ic_correo"
                    app:startIconTint="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreoLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo de contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilClaveLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/login_clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:startIconTint="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClaveLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón ingresar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/login_boton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Enlace a Registro -->
        <TextView
            android:id="@+id/tvIrRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/login_registro"
            android:textColor="@color/rosa_pastel"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.1"
            android:text="@string/splash_footer"
            android:textColor="#99E0C2CE"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
